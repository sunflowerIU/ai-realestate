{
  "name": "realestate-ai",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "scripts": {
    "prebuild": "prisma generate",
    "admin:create": "tsx src/scripts/create-admin.ts",
    "build": "nest build",
    "dev": "prisma generate && nest start --watch",
    "dev:api": "prisma generate && nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "dev:worker": "prisma generate && tsx watch src/worker.ts",
    "start:worker": "node dist/worker.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "11.2.6",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.6",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "11.2.6",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "argon2": "0.45.1",
    "dotenv": "17.2.2",
    "nestjs-pino": "4.4.1",
    "pg": "8.16.3",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "pino-pretty": "13.1.1",
    "prisma": "7.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  },
  "allowScripts": {
    "@nestjs/core@11.2.6": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.25.12": true,
    "prisma@7.10.0": true
  }
}
